<?xml version="1.0" encoding="utf-8"?>
<!--
  Read-only by design (ADR-0003): no canPerformGestures, no key filtering, no
  touch exploration. CI fails if any of these appear.
  packageNames starts as our own app only, so no other app's screen is delivered
  until a guide starts. GuideService then allows exactly the home screen and the
  app being guided, and resets this when the guide ends.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="300"
    android:packageNames="io.github.differentsyntax.karado" />
